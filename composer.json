{
    "name": "dhank77/qris-dinamis",
    "description": "Convert static QRIS to dynamic QRIS in PHP: parse, validate, inject amount & service fee, recalculate CRC16. Zero dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "qris",
        "qris-dinamis",
        "dynamic-qris",
        "qr-code",
        "payment",
        "indonesia",
        "emvco",
        "gpn",
        "crc16"
    ],
    "homepage": "https://github.com/dhank77/qris-dinamis",
    "support": {
        "issues": "https://github.com/dhank77/qris-dinamis/issues",
        "source": "https://github.com/dhank77/qris-dinamis"
    },
    "authors": [
        {
            "name": "M. Hamdani Ilham Latjoro",
            "email": "d41113512@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "Gidhan",
            "homepage": "https://github.com/verssache",
            "role": "Original author (TypeScript)"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "chillerlan/php-qrcode": "Render the dynamic QRIS as a PNG/SVG image on the server (see examples/05-generate-qr-image.php)",
        "endroid/qr-code": "Alternative library for rendering QR images on the server"
    },
    "autoload": {
        "psr-4": {
            "QrisDinamis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrisDinamis\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/qris"
    ],
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t examples/web"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
